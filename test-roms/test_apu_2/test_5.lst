  112  00:814D  EA                nop
  113  00:814E  8D 17 40          sta $4017
  114  00:8151  EA                nop
  115  00:8152  A2 FF             ldx #$ff
  116  00:8154  AD 15 40          lda $4015
  117  00:8157  29 01             and #1
  118  00:8159  F0 0B             beq fail_loop
  119  00:815B            pass_loop:
  120  00:815B  E8                inx
  121  00:815C  BD D1 81          lda test_success, x
  122  00:815F  8D 07 20          sta $2007
  123  00:8162  D0 F7             bne pass_loop
  124  00:8164  F0 09             beq test_end
  125  00:8166            fail_loop:
