  142  00:817C  8D 06 20          sta $2006
  143  00:817F  8D 06 20          sta $2006
  144  00:8182  60                rts
  145                     
  146                     ; wait for vblank starts
  147  00:8183            vwait_start:
  148  00:8183  2C 02 20          bit $2002
  149  00:8186            vwait_start_loop0:
