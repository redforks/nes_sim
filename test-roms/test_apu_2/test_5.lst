  178  00:81A4  A9 00             lda #0
  179  00:81A6  8D 00 20          sta $2000
  180  00:81A9  8D 01 20          sta $2001
  181                     ; disable interrupts
  182  00:81AC  78                sei
  183                     ; reset stack pointer
  184  00:81AD  AE FF 00          ldx $ff
  185  00:81B0  9A                txs
  186                     ; wait for two vblanks
