  100  00:8139  CA                dex
  101  00:813A  D0 FA             bne clear_lc_loop
  102  00:813C  8D 17 40          sta $4017
  103  00:813F  8D 17 40          sta $4017
  104  00:8142  A2 06             ldx #$06
  105  00:8144  A0 1E             ldy #$1e
  106  00:8146            clear_loop:
