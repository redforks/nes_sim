  195  00:81BA  08                php
  196  00:81BB  48                pha
  197  00:81BC  A9 01             lda #1
  198  00:81BE  8D 00 05          sta nmi_hit
  199  00:81C1  68                pla
  200  00:81C2  28                plp
  201  00:81C3  40                rti
