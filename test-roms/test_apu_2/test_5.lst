   72  00:8102  8D 17 40          sta $4017
   73  00:8105  A9 00             lda #0
   74  00:8107  8D 17 40          sta $4017
   75  00:810A  A2 39             ldx #$39
   76  00:810C  A0 18             ldy #$18
   77  00:810E            loop:
