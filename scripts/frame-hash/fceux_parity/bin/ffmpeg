#!/usr/bin/env python3
# Fake ffmpeg: dumps each 1024x960 RGBA frame as 256x240 RGB (nearest 4x undone) to $DUMP_DIR/f%05d.rgb.
# Also reports non-uniform 4x4 blocks (count per frame) into $DUMP_DIR/nonuniform.txt.
import sys, os, threading
args = sys.argv[1:]
inputs = [args[i+1] for i in range(len(args)-1) if args[i] == '-i']
vid_path, aud_path = inputs[0], inputs[1]
out = os.environ['DUMP_DIR']
os.makedirs(out, exist_ok=True)
W, H = 1024, 960
RW, RH = 256, 240
FRAME = W * H * 4
ROWB = W * 4
def video():
    log = open(os.path.join(out, 'nonuniform.txt'), 'w')
    idx = 0
    with open(vid_path, 'rb', buffering=0) as f:
        while True:
            buf = bytearray()
            while len(buf) < FRAME:
                c = f.read(FRAME - len(buf))
                if not c:
                    break
                buf += c
            if len(buf) < FRAME:
                break
            small = bytearray(RW * RH * 3)
            bad = 0
            for y in range(RH):
                base = (y * 4) * ROWB
                r0 = buf[base:base + ROWB]
                for k in range(1, 4):
                    if buf[base + k * ROWB: base + (k + 1) * ROWB] != r0:
                        bad += 1
                        break
                for ch in range(3):
                    v = r0[ch::4]          # 1024 values, channel ch
                    for q in range(1, 4):
                        pass
                    small_ch = v[0::4]
                    small[y * RW * 3 + ch: (y + 1) * RW * 3: 3] = small_ch
                    if v[1::4] != small_ch or v[2::4] != small_ch or v[3::4] != small_ch:
                        bad += 1
            with open(os.path.join(out, 'f%05d.rgb' % idx), 'wb') as o:
                o.write(small)
            log.write('%d %d\n' % (idx, bad)); log.flush()
            idx += 1
    log.write('TOTAL %d\n' % idx); log.close()
def audio():
    with open(aud_path, 'rb', buffering=0) as f:
        while f.read(65536):
            pass
t1 = threading.Thread(target=video); t2 = threading.Thread(target=audio)
t1.start(); t2.start(); t1.join(); t2.join()
